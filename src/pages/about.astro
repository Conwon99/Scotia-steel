---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Header } from "@/sections/Header";
import { CTASection } from "@/sections/Footer/components/CTASection";
import { Footer } from "@/sections/Footer";
import { locations } from "@/data/locations";
import { TrackedTelLink } from "@/components/TrackedTelLink";
import { categories } from "@/data/categories";
import { absoluteUrl, brandName, business, citiesLabel } from "@/data/business";

const brand = brandName();
const cities = citiesLabel();
const canonical = absoluteUrl("/about");
const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": `${canonical}#webpage`,
  url: canonical,
  name: `About ${brand} | Steel Building Specialists`,
  description: `Meet ${brand} — a family-run steel building supplier and contractor serving ${cities} and ${business.region}.`,
  isPartOf: { "@id": `${absoluteUrl("/")}#website` },
  about: { "@id": `${absoluteUrl("/")}#business` },
  inLanguage: "en-GB",
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: absoluteUrl("/") },
    { "@type": "ListItem", position: 2, name: "About", item: canonical },
  ],
};
---

<BaseLayout
  title={`About ${brand} | Steel Building Specialists`}
  description={`Meet ${brand}, a family-run steel building supplier and contractor serving ${cities} and surrounding areas. Free quotes available.`}
  canonical={canonical}
>
  <div class="text-neutral-600 text-lg not-italic normal-nums font-medium accent-auto bg-[#323232] box-border caret-transparent block tracking-[normal] leading-[27px] list-outside list-disc min-h-full pointer-events-auto text-start indent-[0px] normal-case visible border-separate font-manrope">
    <Header client:load />
    <main>
      <section class="box-border caret-transparent pt-[160px] pb-[70px] md:pt-[220px] md:pb-[100px]">
        <div class="box-border caret-transparent max-w-[980px] mx-auto px-5 md:px-8 text-center">
          <p class="text-[#2563eb] text-sm font-semibold uppercase tracking-[0.18em] mb-4">About Us</p>
          <h1 class="text-white text-[34px] font-bold leading-[44px] mb-5 md:text-[64px] md:leading-[78px]">
            About {brand} — Steel Building Specialists in {cities}
          </h1>
          <p class="text-slate-200 max-w-[720px] mx-auto mb-8">Family-run. 16 years' experience. Here when you need us.</p>
          <TrackedTelLink
            client:load
            showPhoneNumber
            prefix="Call "
            className="text-white text-base bg-[#1d4ed8] font-bold border border-[#1d4ed8] px-8 py-4 rounded-[50px] hover:bg-[#2563eb] transition-colors inline-flex"
            trackingLocation="about"
          />
        </div>
      </section>

      <section class="box-border caret-transparent pb-[60px]">
        <div class="box-border caret-transparent max-w-[980px] mx-auto px-5 md:px-8">
          <div class="bg-white rounded-[20px] p-6 md:p-10 space-y-10">
            <div>
              <h2 class="text-gray-900 text-2xl font-bold mb-4 md:text-3xl">How {brand} Got Started</h2>
              <p class="text-gray-700 leading-7">{brand} is a family-run business with 16 years of experience supplying and constructing quality steel buildings. What started in Scotland has grown into a nationwide operation, with our teams travelling from Scotland all the way down to Dover to deliver strong, reliable builds for businesses and homeowners alike.</p>
            </div>

            <div>
              <h2 class="text-gray-900 text-2xl font-bold mb-4 md:text-3xl">Meet the Team</h2>
              <div class="flex flex-col md:flex-row gap-6 items-start">
                <div class="w-32 h-32 rounded-full bg-gray-200 shrink-0 overflow-hidden">
                  <img src={business.assets.about} alt={`${brand} at work`} width="128" height="128" class="w-full h-full object-cover" loading="lazy" />
                </div>
                <div>
                  <h3 class="text-gray-900 text-xl font-bold mb-1">The {brand} Team</h3>
                  <p class="text-gray-600 text-sm mb-3">Steel Building Specialists</p>
                  <p class="text-gray-700 leading-7">{brand} don't just sell you a building — our own teams supply and construct it too. We work with Omega Steel Buildings as our supply chain, and have previously delivered projects for companies including Arnold Clark, Nissan, Travis Perkins, Ryanair and Diageo. We aim to reply to all quote requests within 24 hours — call us on {business.phoneDisplay} or 07798 908238.</p>
                </div>
              </div>
            </div>

            <div>
              <h2 class="text-gray-900 text-2xl font-bold mb-4 md:text-3xl">See Our Recent Work</h2>
              <p class="text-gray-700 leading-7 mb-4">{brand} regularly shares photos of completed steel builds on Facebook, from industrial units to workshops and agricultural buildings. <a href={business.facebookUrl} target="_blank" rel="noopener noreferrer" class="text-[#2563eb] hover:underline font-medium">See recent work on Facebook</a> or browse our <a href="/#projects" class="text-[#2563eb] hover:underline font-medium">project gallery</a>.</p>
            </div>

            <div>
              <h2 class="text-gray-900 text-2xl font-bold mb-4 md:text-3xl">Proudly Serving {cities} and Nationwide UK</h2>
              <p class="text-gray-700 leading-7 mb-4">{brand} covers steel building supply and construction across {business.region}. <a href="/locations" class="text-[#2563eb] hover:underline font-medium">View all service areas</a>.</p>
              <div class="grid grid-cols-2 gap-2 md:grid-cols-3">
                {locations.map((location) => (
                  <a href={`/locations/${location.slug}`} class="text-[#2563eb] hover:underline text-sm">{location.name}</a>
                ))}
              </div>
            </div>

            <div>
              <h2 class="text-gray-900 text-2xl font-bold mb-4 md:text-3xl">Why Customers Choose Us</h2>
              <ul class="text-gray-700 space-y-2 list-disc pl-5">
                <li>Free, no-obligation quotes on all work</li>
                <li>16 years of experience supplying and constructing steel buildings</li>
                <li>We supply and construct — not just sell — with our own teams</li>
                <li>Buildings manufactured and delivered to site in 4-6 working weeks</li>
                <li>We aim to reply to all quote requests within 24 hours</li>
              </ul>
            </div>

            <div>
              <h2 class="text-gray-900 text-2xl font-bold mb-4 md:text-3xl">Our Services</h2>
              <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                {categories.map((category) => (
                  <a href={`/${category.slug}`} class="text-[#2563eb] hover:underline">{category.title}</a>
                ))}
              </div>
            </div>

            <div>
              <h2 class="text-gray-900 text-2xl font-bold mb-4 md:text-3xl">Find Us on Google</h2>
              <!-- AI: paste Google Business Profile embed code -->
              <div class="rounded-xl overflow-hidden border border-gray-200 h-64 bg-gray-100 flex items-center justify-center text-gray-500">
                <p>Google Business Profile embed placeholder — paste your embed code here</p>
              </div>
              <a href={business.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="inline-block mt-4 text-[#2563eb] hover:underline">View on Google Maps</a>
            </div>

            <div>
              <h2 class="text-gray-900 text-2xl font-bold mb-4 md:text-3xl">Follow Us</h2>
              <a href={business.facebookUrl} target="_blank" rel="noopener noreferrer" class="text-[#2563eb] hover:underline">{brand} on Facebook</a>
            </div>
          </div>
        </div>
      </section>

      <section class="box-border caret-transparent pb-[80px]">
        <div class="box-border caret-transparent max-w-[980px] mx-auto px-5 md:px-8">
          <h2 class="text-white text-2xl font-bold mb-4 text-center md:text-3xl">See What Our Customers Say</h2>
          <div class="rounded-xl bg-neutral-900/75 border border-white/10 p-8 text-center text-slate-300 min-h-[200px] flex items-center justify-center">
            <p>Google Reviews widget placeholder — paste your embed code here. <a href="/reviews" class="text-[#2563eb] hover:underline">View reviews on our website</a></p>
          </div>
        </div>
      </section>

      <CTASection client:load />
    </main>
    <Footer client:load />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
